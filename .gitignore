# 真实配置含明文 token —— 绝不入库
config/supervisord-center.config.json

# 运行时产物
logs/
*.log

# 迁移归档（可能含旧 token）
_archive-*/

# 临时
*.tmp
*.bak
*~

# 页面编辑中转文件。
#
# 页面**唯一真相是 src/supervisord-center.js 里的 PAGE_HTML / LOGIN_HTML**。
# 这两个文件只是用 tools/splice-page.js extract 拆出来、方便用 HTML 工具
# 编辑的中转副本。它们**不入库** —— 否则仓库里会有两份页面，改了一份忘了同步，
# 就会出现「代码里是新的、跑起来是旧的」这种最难查的问题。
src/_newpage.html
src/_login.html

# 界面截图（本地验证用）
_shots/

# Node（本项目零依赖，但以防万一）
node_modules/
package-lock.json
